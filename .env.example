# Domínio Base da Aplicação (Suporte a sslip.io para wildcard DNS / IP dinâmico)
NEXT_PUBLIC_APP_URL=http://127.0.0.1.sslip.io:3005

# Cloudflare R2 Configuration (S3-Compatible API)
R2_ACCOUNT_ID=seu_cloudflare_account_id
R2_ACCESS_KEY_ID=sua_r2_access_key
R2_SECRET_ACCESS_KEY=sua_r2_secret_key
R2_BUCKET_NAME=temp-videos
R2_PUBLIC_DOMAIN=https://pub-xxx.r2.dev

# AWS Credentials (para DynamoDB - Metadados com TTL)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_aws_access_key
AWS_SECRET_ACCESS_KEY=sua_aws_secret_key
DYNAMODB_TABLE_NAME=TempVideos

# Fallback Modo Local
USE_LOCAL_FALLBACK=true
