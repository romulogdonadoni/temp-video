# Domínio Base da Aplicação (Opcional)
NEXT_PUBLIC_APP_URL=

# Chave de Desenvolvedor para exclusão de vídeos via URL (?delete=devkey)
DEV_DELETE_KEY=devkey

# Cloudflare R2 Configuration (S3-Compatible API)
R2_ACCOUNT_ID=seu_cloudflare_account_id
R2_ACCESS_KEY_ID=sua_r2_access_key
R2_SECRET_ACCESS_KEY=sua_r2_secret_key
R2_BUCKET_NAME=video-vault
R2_PUBLIC_DOMAIN=https://pub-xxx.r2.dev

# Modo Fallback Local
USE_LOCAL_FALLBACK=false
